<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="INSERT INTO @Totals (Currency, RetailSales, ServiceSales)&#xd;&#xa;        SELECT&#xd;&#xa;            t.Currency,&#xd;&#xa;            SUM(CASE WHEN l.LineType = &apos;Goods&apos;&#xd;&#xa;                THEN l.Quantity * l.UnitPrice * (1 + r.Rate) ELSE 0 END),&#xd;&#xa;            SUM(CASE WHEN l.LineType = &apos;Service&apos;&#xd;&#xa;                THEN l.Quantity * l.UnitPrice * (1 + r.Rate) ELSE 0 END)&#xd;&#xa;        FROM dbo.CounterTransactions AS t&#xd;&#xa;        INNER JOIN dbo.TransactionLines AS l&#xd;&#xa;            ON l.TransactionId = t.TransactionId&#xd;&#xa;        -- Money-order lines carry no tax, so they may have no rate.&#xd;&#xa;        LEFT JOIN dbo.TransactionTaxRates AS r&#xd;&#xa;            ON r.TransactionId = l.TransactionId&#xd;&#xa;            AND r.TaxCategory = l.TaxCategory&#xd;&#xa;        WHERE t.BranchCode = @BranchCode&#xd;&#xa;            AND t.Status = &apos;Paid&apos;&#xd;&#xa;            AND t.OccurredAtUtc &gt;= @From&#xd;&#xa;            AND t.OccurredAtUtc &lt; @To&#xd;&#xa;        GROUP BY t.Currency&#xd;&#xa;        -- The dates are local variables, which the optimizer cannot otherwise see.&#xd;&#xa;        -- See docs/adr/0024-index-choices.md.&#xd;&#xa;        OPTION (RECOMPILE)" StatementId="2" StatementCompId="16" StatementType="INSERT" StatementSqlHandle="0x09002CF168F82DE28870B74AF645C628F7A50000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="1378103950" BatchSqlHandle="0x030006008E3224525FEC4501F4B4000001000000000000000000000000000000000000000000000000000000" StatementParameterizationType="0" RetrievedFromCache="false" StatementSubTreeCost="6.90034" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x8FB2E1E4C9C91FAE" QueryPlanHash="0xC3A7DA0A68D4C9D0" 
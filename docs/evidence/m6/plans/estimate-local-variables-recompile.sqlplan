<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT t.Currency,&#xa;    SUM(CASE WHEN l.LineType = &apos;Goods&apos; THEN l.Quantity * l.UnitPrice * (1 + r.Rate) ELSE 0 END),&#xa;    SUM(CASE WHEN l.LineType = &apos;Service&apos; THEN l.Quantity * l.UnitPrice * (1 + r.Rate) ELSE 0 END)&#xa;FROM dbo.CounterTransactions AS t&#xa;INNER JOIN dbo.TransactionLines AS l ON l.TransactionId = t.TransactionId&#xa;LEFT JOIN dbo.TransactionTaxRates AS r ON r.TransactionId = l.TransactionId AND r.TaxCategory = l.TaxCategory&#xa;WHERE t.BranchCode = @BranchCode AND t.Status = &apos;Paid&apos; AND t.OccurredAtUtc &gt;= @From AND t.OccurredAtUtc &lt; @To&#xa;GROUP BY t.Currency OPTION (RECOMPILE)" StatementId="1" StatementCompId="4" StatementType="SELECT" StatementSqlHandle="0x090083822A48F40FE98263BA281F3F434DA20000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="false" StatementSubTreeCost="3.31919" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x9E00AC1A7F087A68" QueryPlanHash="0xC938B8B990B07BD0" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="1024" CachedPlanSize="72" CompileTime="10" CompileCPU="10" CompileMemory="928"><Warnings><MemoryGrantWarning GrantWarningKind="Excessive Grant" RequestedMemory="1024" GrantedMemory="1024" MaxUsedMemory="16"></MemoryGrantWarning></Warnings><MemoryGrantInfo SerialRequiredMemory="512" SerialDesiredMemory="608" RequiredMemory="512" DesiredMemory="608" RequestedMemory="1024" GrantWaitTime="0" MaxQueryMemory="3106616" GrantedMemory="10
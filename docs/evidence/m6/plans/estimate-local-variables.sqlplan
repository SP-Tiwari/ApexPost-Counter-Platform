<ShowPlanXML xmlns="http://schemas.microsoft.com/sqlserver/2004/07/showplan" Version="1.599" Build="17.0.1000.7"><BatchSequence><Batch><Statements><StmtSimple StatementText="SELECT t.Currency,&#xa;    SUM(CASE WHEN l.LineType = &apos;Goods&apos; THEN l.Quantity * l.UnitPrice * (1 + r.Rate) ELSE 0 END),&#xa;    SUM(CASE WHEN l.LineType = &apos;Service&apos; THEN l.Quantity * l.UnitPrice * (1 + r.Rate) ELSE 0 END)&#xa;FROM dbo.CounterTransactions AS t&#xa;INNER JOIN dbo.TransactionLines AS l ON l.TransactionId = t.TransactionId&#xa;LEFT JOIN dbo.TransactionTaxRates AS r ON r.TransactionId = l.TransactionId AND r.TaxCategory = l.TaxCategory&#xa;WHERE t.BranchCode = @BranchCode AND t.Status = &apos;Paid&apos; AND t.OccurredAtUtc &gt;= @From AND t.OccurredAtUtc &lt; @To&#xa;GROUP BY t.Currency" StatementId="1" StatementCompId="4" StatementType="SELECT" StatementSqlHandle="0x0900E0FFFBBB59DE3FB4E8E31B0C0D3C06CD0000000000000000000000000000000000000000000000000000" DatabaseContextSettingsId="2" ParentObjectId="0" StatementParameterizationType="1" RetrievedFromCache="true" StatementSubTreeCost="109.081" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0xB374DC211C94EB0C" QueryPlanHash="0xC2C54C863326B82F" CardinalityEstimationModelVersion="170"><StatementSetOptions QUOTED_IDENTIFIER="true" ARITHABORT="false" CONCAT_NULL_YIELDS_NULL="true" ANSI_NULLS="true" ANSI_PADDING="true" ANSI_WARNINGS="true" NUMERIC_ROUNDABORT="false"></StatementSetOptions><QueryPlan DegreeOfParallelism="1" MemoryGrant="14136" CachedPlanSize="96" CompileTime="636" CompileCPU="66" CompileMemory="1000"><Warnings><MemoryGrantWarning GrantWarningKind="Excessive Grant" RequestedMemory="14136" GrantedMemory="14136" MaxUsedMemory="160"></MemoryGrantWarning></Warnings><MemoryGrantInfo SerialRequiredMemory="1664" SerialDesiredMemory="14136" RequiredMemory="1664" DesiredMemory="14136" RequestedMemory="14136" GrantWaitTime="0" MaxQueryMemory="3106616" GrantedMemory="14136" Ma
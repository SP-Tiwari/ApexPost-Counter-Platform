@model ApexPost.Web.Models.MoneyOrderCreateViewModel
@{
    ViewData["Title"] = "Process money order";
}

<h1>Process money order</h1>
<p>Money order currency: @ViewData["MoneyOrderCurrency"]</p>
<p>
    For high-value orders, inspect the original identity document in person.
    Only its document type and masked identifier are retained.
</p>

<div asp-validation-summary="All" class="text-danger" role="alert"></div>

<form asp-controller="MoneyOrders" asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Amount" class="form-label">Amount</label>
        <input asp-for="Amount" class="form-control" type="number" min="0.01" step="0.01" required />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Sender" class="form-label"></label>
        <input asp-for="Sender" class="form-control" required maxlength="100" />
        <span asp-validation-for="Sender" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Recipient" class="form-label"></label>
        <input asp-for="Recipient" class="form-control" required maxlength="100" />
        <span asp-validation-for="Recipient" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Fee" class="form-label"></label>
        <input asp-for="Fee" class="form-control" type="number" min="0" step="0.01" required />
        <span asp-validation-for="Fee" class="text-danger"></span>
    </div>

    <fieldset class="mb-3">
        <legend>Identity verification</legend>
        <div class="form-check">
            <input asp-for="DocumentCheckedInPerson" class="form-check-input" />
            <label asp-for="DocumentCheckedInPerson" class="form-check-label">
                I inspected the original identity document in person
            </label>
        </div>
        <div class="mb-3">
            <label asp-for="DocumentType" class="form-label"></label>
            <input asp-for="DocumentType" class="form-control" maxlength="50" />
        </div>
        <div class="mb-3">
            <label asp-for="DocumentIdentifier" class="form-label">
                Document identifier (used only to create a masked record)
            </label>
            <input asp-for="DocumentIdentifier"
                   class="form-control"
                   autocomplete="off"
                   maxlength="100" />
        </div>
        <div class="form-check">
            <input asp-for="IdentityCheckPassed" class="form-check-input" />
            <label asp-for="IdentityCheckPassed" class="form-check-label">
                The in-person identity check succeeded
            </label>
        </div>
    </fieldset>

    <button type="submit" class="btn btn-primary">Process money order</button>
    <a asp-controller="MoneyOrders" asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@model ApexPost.Web.Models.AdministrationViewModel
@{ ViewData["Title"] = "Administration"; }
<h1>Administration</h1>
<div asp-validation-summary="All" class="text-danger"></div>
<div class="row"><div class="col-md-4"><h2>Add branch</h2><form asp-action="CreateBranch" method="post"><input name="Code" class="form-control mb-2" placeholder="Branch code" required /><input name="Name" class="form-control mb-2" placeholder="Name" required /><input name="Region" class="form-control mb-2" placeholder="Region" required /><input name="OpeningHours" class="form-control mb-2" placeholder="Opening hours" required /><input name="TerminalId" class="form-control mb-2" placeholder="First terminal ID" required /><input name="TerminalName" class="form-control mb-2" placeholder="First terminal name" required /><button class="btn btn-primary">Add branch</button></form></div>
<div class="col-md-4"><h2>Add staff</h2><form asp-action="CreateStaff" method="post"><input name="Id" class="form-control mb-2" placeholder="Staff ID" required /><input name="Name" class="form-control mb-2" placeholder="Name" required /><input name="Email" type="email" class="form-control mb-2" placeholder="Email" required /><select name="Role" class="form-select mb-2" asp-items="Html.GetEnumSelectList<StaffRole>()"></select><select name="HomeBranchCode" class="form-select mb-2">@foreach (var branch in Model.Branches) { <option value="@branch.Code.Value">@branch.Code.Value</option> }</select><button class="btn btn-primary">Add staff</button></form></div>
<div class="col-md-4"><h2>Add product</h2><form asp-action="CreateProduct" method="post"><input name="Sku" class="form-control mb-2" placeholder="SKU" required /><input name="Name" class="form-control mb-2" placeholder="Name" required /><select name="Category" class="form-select mb-2" asp-items="Html.GetEnumSelectList<ProductCategory>()"></select><input name="UnitPrice" type="number" min="0" step="0.01" class="form-control mb-2" placeholder="Unit price" required /><input name="Currency" value="INR" maxlength="3" class="form-control mb-2" required /><select name="TaxCategory" class="form-select mb-2" asp-items="Html.GetEnumSelectList<TaxCategory>()"></select><button class="btn btn-primary">Add product</button></form></div></div>
<h2 class="mt-4">Branches</h2><table class="table"><thead><tr><th>Code</th><th>Name</th><th>Region</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var branch in Model.Branches) { <tr><td>@branch.Code</td><td>@branch.Name</td><td>@branch.Region</td><td>@(branch.IsActive ? "Active" : "Closed")</td><td><form asp-action="SetBranchStatus" method="post"><input type="hidden" name="code" value="@branch.Code.Value" /><input type="hidden" name="isActive" value="@(!branch.IsActive)" /><button class="btn btn-outline-secondary btn-sm">@(branch.IsActive ? "Close" : "Reopen")</button></form></td></tr> }</tbody></table>
<h2>Staff</h2><table class="table"><thead><tr><th>ID</th><th>Name</th><th>Role</th><th>Home branch</th><th>Active</th><th></th></tr></thead><tbody>@foreach (var staff in Model.Staff) { <tr><form asp-action="UpdateStaff" method="post"><td>@staff.Id<input type="hidden" name="staffId" value="@staff.Id" /></td><td>@staff.Name</td><td><select name="role" class="form-select form-select-sm">@foreach (var role in Enum.GetValues<StaffRole>()) { <option value="@role" selected="@(role == staff.Role)">@role</option> }</select></td><td><select name="homeBranchCode" class="form-select form-select-sm">@foreach (var branch in Model.Branches) { <option value="@branch.Code.Value" selected="@(branch.Code == staff.HomeBranchCode)">@branch.Code.Value</option> }</select></td><td><input type="checkbox" name="isActive" value="true" checked="@staff.IsActive" /></td><td><button class="btn btn-outline-primary btn-sm">Save</button></td></form></tr> }</tbody></table>
<h2>Catalogue</h2><table class="table"><thead><tr><th>SKU</th><th>Name</th><th>Category</th><th>Price</th></tr></thead><tbody>@foreach (var product in Model.Products) { <tr><td>@product.Sku</td><td>@product.Name</td><td>@product.Category</td><td>@product.UnitPrice.Amount @product.UnitPrice.Currency</td></tr> }</tbody></table>

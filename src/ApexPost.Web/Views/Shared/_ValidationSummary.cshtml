@*
    Server validation errors for forms without client validation. Replaces
    asp-validation-summary="All", whose empty placeholder carries an inline
    style that the CSP blocks.
*@
@{
    var errors = ViewData.ModelState.Values
        .SelectMany(entry => entry.Errors)
        .Select(error => error.ErrorMessage)
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .Distinct(StringComparer.Ordinal)
        .ToArray();
}
@if (errors.Length > 0)
{
    <div class="validation-summary-errors text-danger" role="alert">
        <ul>
            @foreach (var error in errors)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

@using System.Security.Claims
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    // The identity's name claim is the staff ID, so read the display name.
    var staffName = User.FindFirst(ClaimTypes.Name)?.Value ?? User.Identity?.Name ?? "Staff";
    var role = User.FindFirst("Role")?.Value;
    var initials = string.Concat(staffName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => char.ToUpperInvariant(part[0])));
    var roleLabel = role switch
    {
        "CounterClerk" => "Counter clerk",
        "BranchManager" => "Branch manager",
        null => null,
        _ => role
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ApexPost Logistics</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ApexPost.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <template class="table-search-icon-template">@Html.Icon("search", "icon-sm")</template>

    @if (signedIn)
    {
        <a class="visually-hidden-focusable position-absolute m-2 btn btn-primary" href="#main-content">Skip to content</a>

        <aside class="app-sidebar" id="app-sidebar" aria-label="Main navigation">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index" title="ApexPost Logistics">
                <partial name="_BrandMark" />
                <span class="brand-text">
                    <span class="brand-name">ApexPost</span>
                    <span class="brand-tagline">Logistics</span>
                </span>
            </a>
            <partial name="_SidebarNav" />
            <div class="sidebar-footer">ApexPost Counter Platform</div>
        </aside>
        <div class="sidebar-backdrop" data-sidebar-close></div>

        <div class="app-main">
            <header class="app-topbar">
                <button type="button" class="icon-button" data-sidebar-toggle
                        aria-controls="app-sidebar" aria-expanded="true" aria-label="Toggle navigation">
                    @Html.Icon("menu")
                </button>
                <p class="topbar-title">@ViewData["Title"]</p>
                @* No branch is shown here: the sign-in claim can be stale, so pages show
                   the persisted home branch instead. *@
                <div class="topbar-actions">
                    <div class="dropdown">
                        <button type="button" class="user-menu-button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar" aria-hidden="true">@initials</span>
                            <span class="user-meta">
                                <span class="user-name">@staffName</span>
                                @if (roleLabel is not null)
                                {
                                    <span class="user-role">@roleLabel</span>
                                }
                            </span>
                            @Html.Icon("chevron-down", "icon-sm")
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow-sm">
                            <div class="px-3 py-2">
                                <div class="fw-semibold">@staffName</div>
                                @if (roleLabel is not null)
                                {
                                    <div class="small text-secondary">@roleLabel</div>
                                }
                            </div>
                            <div class="dropdown-divider"></div>
                            <form asp-controller="Account" asp-action="SignOut" method="post" data-no-busy>
                                <button type="submit" class="dropdown-item d-flex align-items-center gap-2">
                                    @Html.Icon("logout", "icon-sm") Sign out
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>

            <main role="main" id="main-content" class="app-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                &copy; 2026 ApexPost Logistics &middot; <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </div>
    }
    else
    {
        <div class="auth-shell">
            <header class="auth-topbar">
                <a class="sidebar-brand border-0 px-0" asp-controller="Home" asp-action="Index">
                    <partial name="_BrandMark" />
                    <span class="brand-text">
                        <span class="brand-name">ApexPost</span>
                        <span class="brand-tagline">Logistics</span>
                    </span>
                </a>
                <a class="btn btn-sm btn-outline-light ms-auto" asp-controller="Account" asp-action="SignIn">Staff sign-in</a>
            </header>
            <main role="main" id="main-content" class="auth-content">
                @RenderBody()
            </main>
            <footer class="app-footer">
                &copy; 2026 ApexPost Logistics &middot; <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </footer>
        </div>
    }

    <div class="toast-stack" aria-live="polite">
        @RenderSection("Toasts", required: false)
    </div>

    <div class="modal fade" id="confirm-dialog" tabindex="-1" aria-labelledby="confirm-dialog-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="confirm-dialog-title" data-dialog-title>Please confirm</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0" data-dialog-message></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger" data-dialog-accept>Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

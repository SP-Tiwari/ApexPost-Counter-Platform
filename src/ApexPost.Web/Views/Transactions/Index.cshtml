@model IReadOnlyList<ApexPost.Web.Models.TransactionListViewModel>
@{
    ViewData["Title"] = "Transactions";
}

<h1>Transactions</h1>

<p>
    <a asp-controller="Transactions"
       asp-action="Create"
       class="btn btn-primary">Create transaction</a>
</p>

@if (Model.Count == 0)
{
    <p>No transactions have been created.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Transaction ID</th>
                <th scope="col">Status</th>
                <th scope="col">Total</th>
                <th scope="col">Branch</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var transaction in Model)
            {
                <tr>
                    <td>@transaction.Id</td>
                    <td>@transaction.PaymentStatus</td>
                    <td>@transaction.Total @transaction.Currency</td>
                    <td>@(transaction.BranchCode ?? "Not recorded")</td>
                    <td>
                        <a asp-controller="Transactions"
                           asp-action="Details"
                           asp-route-transactionId="@transaction.Id">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

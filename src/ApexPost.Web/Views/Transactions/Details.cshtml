@model ApexPost.Web.Models.TransactionDetailsViewModel
@{
    ViewData["Title"] = "Transaction details";
    // Void and refund are manager-only (BranchManagerOnly); a clerk sees their sale read-only.
    var isManager = User.IsInRole(nameof(ApexPost.Domain.Enums.StaffRole.BranchManager));
}

<h1>Transaction details</h1>

@if (TempData["TransactionActionStatus"] is string statusMessage)
{
    <div class="alert alert-success" role="status">@statusMessage</div>
}

@if (ViewData["TransactionActionError"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<dl class="row">
    <dt class="col-sm-3">Transaction ID</dt>
    <dd class="col-sm-9">@Model.Id</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.PaymentStatus</dd>
    <dt class="col-sm-3">Subtotal</dt>
    <dd class="col-sm-9">@Model.Subtotal @Model.Currency</dd>
    <dt class="col-sm-3">Tax</dt>
    <dd class="col-sm-9">@Model.Tax @Model.Currency</dd>
    <dt class="col-sm-3">Total</dt>
    <dd class="col-sm-9">@Model.Total @Model.Currency</dd>
    @if (Model.BranchCode is not null)
    {
        <dt class="col-sm-3">Processed at branch</dt>
        <dd class="col-sm-9">@Model.BranchCode</dd>
    }
    @if (Model.OccurredAtUtc is { } occurredAtUtc)
    {
        <dt class="col-sm-3">Recorded (UTC)</dt>
        <dd class="col-sm-9">@occurredAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</dd>
    }
    @if (Model.CounterTerminalId is not null)
    {
        <dt class="col-sm-3">Counter terminal</dt>
        <dd class="col-sm-9">@Model.CounterTerminalId</dd>
        <dt class="col-sm-3">Clerk</dt>
        <dd class="col-sm-9">@Model.ClerkStaffId</dd>
        <dt class="col-sm-3">Payment method</dt>
        <dd class="col-sm-9">@Model.PaymentMethod</dd>
    }
</dl>

<h2>Line items</h2>
@if (Model.LineItems.Any(item => item.ShippingDetails is not null))
{
    <p><a asp-action="Label" asp-route-transactionId="@Model.Id">Preview shipping label</a></p>
}
@if (Model.LineItems.Count == 0)
{
    <p>This transaction has no line items.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th scope="col">Description</th>
                <th scope="col">Type</th>
                <th scope="col">Unit price</th>
                <th scope="col">Quantity</th>
                <th scope="col">Subtotal</th>
                <th scope="col">Shipping details</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.LineItems)
            {
                <tr>
                    <td>@item.Description</td>
                    <td>@item.Type</td>
                    <td>@item.UnitPrice @item.Currency</td>
                    <td>@item.Quantity</td>
                    <td>@item.Subtotal @item.Currency</td>
                    <td>@item.ShippingDetails</td>
                </tr>
            }
        </tbody>
    </table>
}

@if (Model.Notifications.Count > 0)
{
    <h2>Transaction notifications</h2>
    <ul>
        @foreach (var notification in Model.Notifications)
        {
            <li>@notification.Type: @notification.Reason</li>
        }
    </ul>
}

@if (isManager && Model.PaymentStatus is ApexPost.Domain.Enums.TransactionPaymentStatus.Open
    or ApexPost.Domain.Enums.TransactionPaymentStatus.Paid)
{
    <h2>Void transaction</h2>
    <form asp-controller="Transactions"
          asp-action="Void"
          asp-route-transactionId="@Model.Id"
          method="post">
        <div class="mb-3">
            <label for="void-reason" class="form-label">Reason</label>
            <input id="void-reason"
                   name="Reason"
                   class="form-control"
                   required
                   maxlength="500" />
        </div>
        <button type="submit" class="btn btn-danger">Void transaction</button>
    </form>
}

@if (isManager && Model.PaymentStatus == ApexPost.Domain.Enums.TransactionPaymentStatus.Paid)
{
    <h2>Refund transaction</h2>
    <form asp-controller="Transactions"
          asp-action="Refund"
          asp-route-transactionId="@Model.Id"
          method="post">
        <div class="mb-3">
            <label for="refund-reason" class="form-label">Reason</label>
            <input id="refund-reason"
                   name="Reason"
                   class="form-control"
                   required
                   maxlength="500" />
        </div>
        <button type="submit" class="btn btn-warning">Refund transaction</button>
    </form>
}

@if (isManager)
{
    <a asp-controller="Transactions" asp-action="Index">Back to transactions</a>
}
else
{
    <a asp-controller="Transactions" asp-action="Create">New transaction</a>
}

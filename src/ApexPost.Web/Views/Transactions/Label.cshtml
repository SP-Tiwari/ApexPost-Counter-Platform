@model ApexPost.Web.Models.ShippingLabelViewModel
@{
    ViewData["Title"] = "Shipping label preview";
}

<div class="page-header d-print-none">
    <div>
        <p class="page-eyebrow">Shipping</p>
        <h1>Shipping label preview</h1>
        <p class="page-subtitle">@Model.Items.Count label(s) for this transaction.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-transactionId="@Model.TransactionId">@Html.Icon("back", "icon-sm") Back to transaction</a>
        <button type="button" class="btn btn-primary" data-print-page>Print labels</button>
    </div>
</div>

@if (Model.PaymentStatus != ApexPost.Domain.Enums.TransactionPaymentStatus.Paid)
{
    <div class="alert alert-warning d-flex gap-2" role="alert">
        @Html.Icon("alert")
        <span>This transaction is @Model.PaymentStatus. Do not use these labels.</span>
    </div>
}

<div class="row g-4">
    @foreach (var item in Model.Items)
    {
        <div class="col-xl-6">
            <section class="shipping-label card border-dark border-2 p-3" aria-label="Label @item.ShipmentId">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="d-inline-flex align-items-center gap-2 fs-4 fw-bold">
                        <partial name="_BrandMark" /> ApexPost
                    </span>
                    <span class="label-service">@item.ServiceLevel</span>
                </div>
                <p class="font-monospace fs-3 text-center my-3">@item.ShipmentId</p>
                <dl class="detail-list mb-0">
                    <dt>Destination zone</dt>
                    <dd>@item.DestinationZone</dd>
                    <dt>Item type</dt>
                    <dd>@item.Type</dd>
                    <dt>Weight</dt>
                    <dd>@item.WeightKilograms kg</dd>
                    <dt>Dimensions</dt>
                    <dd>@item.LengthCm x @item.WidthCm x @item.HeightCm cm</dd>
                    <dt>Origin branch</dt>
                    <dd>@Model.OriginBranchCode</dd>
                    @if (Model.OccurredAtUtc is { } occurredAtUtc)
                    {
                        <dt>Accepted (UTC)</dt>
                        <dd>@occurredAtUtc.ToString("yyyy-MM-dd HH:mm")</dd>
                    }
                    <dt>Transaction</dt>
                    <dd class="small">@Model.TransactionId</dd>
                </dl>
            </section>
        </div>
    }
</div>

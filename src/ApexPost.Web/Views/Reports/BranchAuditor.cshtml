@model IReadOnlyList<ApexPost.Domain.Reporting.BranchAuditorReportRow>

@{
    ViewData["Title"] = "Branch auditor report";
}

<h1>Branch auditor report</h1>
<p>Money orders and identity-verification outcomes grouped by branch.</p>

@if (Model.Count == 0)
{
    <p>No money-order activity with branch attribution was found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Branch</th>
                <th>Money orders</th>
                <th>Identity verifications</th>
                <th>Successful checks</th>
                <th>Failed checks</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td>@row.BranchCode.Value</td>
                    <td>@row.MoneyOrderCount</td>
                    <td>@row.IdentityVerificationCount</td>
                    <td>@row.SuccessfulIdentityVerificationCount</td>
                    <td>@row.FailedIdentityVerificationCount</td>
                </tr>
            }
        </tbody>
    </table>
}
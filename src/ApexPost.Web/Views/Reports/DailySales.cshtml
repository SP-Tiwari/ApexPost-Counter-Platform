@model IReadOnlyList<ApexPost.Domain.Reporting.DailySalesReportRow>

@{
    ViewData["Title"] = "Daily sales report";
    var businessDate = (DateOnly?)ViewData["BusinessDate"];
}

<h1>Daily sales report</h1>

<form asp-controller="Reports" asp-action="DailySales" method="get" class="mb-3">
    <label for="business-date" class="form-label">Business date</label>
    <input id="business-date"
           name="businessDate"
           type="date"
           class="form-control"
           value="@(businessDate?.ToString("yyyy-MM-dd") ?? string.Empty)" />
    <button type="submit" class="btn btn-primary mt-2">View report</button>
</form>

@if (Model.Count == 0)
{
    <p>No paid transactions were found for this branch on the selected date.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Branch</th>
                <th>Date</th>
                <th>Retail sales</th>
                <th>Service sales</th>
                <th>Total sales</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td>@row.BranchCode.Value</td>
                    <td>@row.BusinessDate</td>
                    <td>@row.RetailSales.Amount @row.RetailSales.Currency</td>
                    <td>@row.ServiceSales.Amount @row.ServiceSales.Currency</td>
                    <td>@row.TotalSales.Amount @row.TotalSales.Currency</td>
                </tr>
            }
        </tbody>
    </table>
}
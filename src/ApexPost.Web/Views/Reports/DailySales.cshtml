@model IReadOnlyList<ApexPost.Web.Models.DailySalesRowViewModel>

@{
    ViewData["Title"] = "Daily sales report";
    var businessDate = (DateOnly?)ViewData["BusinessDate"];
    var currencies = Model.Select(row => row.Currency).Distinct(StringComparer.Ordinal).ToArray();
    var singleCurrency = currencies.Length == 1 ? currencies[0] : null;
}

<div class="page-header">
    <div>
        <p class="page-eyebrow">Reports</p>
        <h1>Daily sales report</h1>
        <p class="page-subtitle">Paid sales for your branch on one business date.</p>
    </div>
    <form asp-controller="Reports" asp-action="DailySales" method="get" class="d-flex flex-wrap align-items-end gap-2">
        <div>
            <label for="business-date" class="form-label">Business date</label>
            <input id="business-date"
                   name="businessDate"
                   type="date"
                   class="form-control"
                   value="@(businessDate?.ToString("yyyy-MM-dd") ?? string.Empty)" />
        </div>
        <button type="submit" class="btn btn-primary">@Html.Icon("calendar", "icon-sm") View report</button>
    </form>
</div>

@if (Model.Count == 0)
{
    <div class="card">
        <partial name="_EmptyState" model="@(new EmptyStateViewModel("chart", "No paid transactions were found for this branch on the selected date.", "Choose another business date to see its sales."))" />
    </div>
}
else
{
    @if (singleCurrency is not null)
    {
        var retail = Model.Sum(row => row.RetailSales);
        var service = Model.Sum(row => row.ServiceSales);
        var total = Model.Sum(row => row.TotalSales);
        <div class="row g-3 mb-3">
            <div class="col-lg-8">
                <div class="row g-3">
                    <div class="col-sm-4">
                        <div class="card kpi-card">
                            <div class="card-body">
                                <span class="kpi-icon tone-success">@Html.Icon("money")</span>
                                <div>
                                    <p class="kpi-label">Total sales</p>
                                    <p class="kpi-value">@total.ToString("N2")<span class="kpi-unit">@singleCurrency</span></p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="card kpi-card">
                            <div class="card-body">
                                <span class="kpi-icon">@Html.Icon("package")</span>
                                <div>
                                    <p class="kpi-label">Retail sales</p>
                                    <p class="kpi-value">@retail.ToString("N2")<span class="kpi-unit">@singleCurrency</span></p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="card kpi-card">
                            <div class="card-body">
                                <span class="kpi-icon tone-accent">@Html.Icon("truck")</span>
                                <div>
                                    <p class="kpi-label">Service sales</p>
                                    <p class="kpi-value">@service.ToString("N2")<span class="kpi-unit">@singleCurrency</span></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-header">
                        <h2 class="card-title-sm">@Html.Icon("chart", "icon-sm") Sales mix</h2>
                    </div>
                    <div class="card-body">
                        <partial name="_DonutChart" model="@(new DonutChartViewModel(
                            [new ChartPoint("Retail", retail), new ChartPoint("Services", service)],
                            total.ToString("N2"),
                            singleCurrency))" />
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card table-card">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Branch</th>
                        <th>Date</th>
                        <th>Retail sales</th>
                        <th>Service sales</th>
                        <th>Total sales</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        <tr>
                            <td>@row.BranchCode</td>
                            <td>@row.BusinessDate</td>
                            <td>@row.RetailSales @row.Currency</td>
                            <td>@row.ServiceSales @row.Currency</td>
                            <td>@row.TotalSales @row.Currency</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

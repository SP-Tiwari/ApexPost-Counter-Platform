@model IReadOnlyList<ApexPost.Domain.Reporting.LowStockReportRow>

@{
    ViewData["Title"] = "Low-stock report";
}

<h1>Low-stock report</h1>
<p>Stock at or below the configured threshold for your home branch.</p>

@if (Model.Count == 0)
{
    <p>No low-stock items were found for your home branch.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Branch</th>
                <th>Product SKU</th>
                <th>Quantity</th>
                <th>Threshold</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td>@row.BranchCode.Value</td>
                    <td>@row.ProductSku.Value</td>
                    <td>@row.Quantity</td>
                    <td>@row.Threshold</td>
                </tr>
            }
        </tbody>
    </table>
}

@model IReadOnlyList<ApexPost.Domain.Reporting.ShippingVolumeReportRow>

@{
    ViewData["Title"] = "Shipping volume report";
}

<h1>Shipping volume report</h1>
<p>Shipment counts by destination zone and service level across all recorded shipping items.</p>

@if (Model.Count == 0)
{
    <p>No shipping items were found.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Destination zone</th>
                <th>Service level</th>
                <th>Shipments</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model)
            {
                <tr>
                    <td>@row.DestinationZone</td>
                    <td>@row.ServiceLevel</td>
                    <td>@row.ShipmentCount</td>
                </tr>
            }
        </tbody>
    </table>
}

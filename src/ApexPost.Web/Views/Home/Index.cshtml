@model ApexPost.Web.Models.DashboardViewModel?
@using ApexPost.Application.Courier
@using ApexPost.Domain.Enums
@{
    ViewData["Title"] = "Branch dashboard";
}

@if (Model is null)
{
    <div class="auth-wide">
        <div class="row g-4 align-items-stretch">
            <div class="col-lg-6">
                <div class="signin-hero h-100">
                    <p class="page-eyebrow text-info">ApexPost Logistics</p>
                    <h1 class="text-white h2">ApexPost Counter Platform</h1>
                    <p class="mb-0">Counter sales, shipping, money orders and branch reporting in one place.</p>
                    <ul>
                        <li>@Html.Icon("receipt") Counter transactions with receipts and labels</li>
                        <li>@Html.Icon("truck") Shipping rates, zones and service levels</li>
                        <li>@Html.Icon("shield") Identity-checked money orders</li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column justify-content-center p-4">
                        <h2 class="h4">Welcome</h2>
                        <p class="text-secondary">Sign in with your staff account to see your branch dashboard.</p>
                        <div>
                            <a class="btn btn-primary" asp-controller="Account" asp-action="SignIn">
                                @Html.Icon("lock", "icon-sm") Sign in
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    return;
}

@{
    var isManager = Model.Role == StaffRole.BranchManager;
    var canSell = Model.Role is StaffRole.CounterClerk or StaffRole.BranchManager;
    var firstName = Model.StaffName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? Model.StaffName;
    var inactiveCounters = Model.Branch.CounterCount - Model.Branch.ActiveCounterCount;
}

<div class="page-header">
    <div>
        <p class="page-eyebrow">Dashboard</p>
        <h1>Welcome back, @firstName</h1>
        <p class="page-subtitle">
            @Model.Branch.Name (@Model.Branch.Code) &middot; signed in as @Model.StaffName (@Model.Role)
        </p>
        <ul class="meta-list">
            <li>@Html.Icon("pin", "icon-sm") Region @Model.Branch.Region</li>
            <li>@Html.Icon("clock", "icon-sm") Hours @Model.Branch.OpeningHours</li>
            <li>@Html.Icon("calendar", "icon-sm") Updated @Model.GeneratedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</li>
        </ul>
    </div>
    @if (canSell)
    {
        <div class="page-actions">
            <a class="btn btn-primary" asp-controller="Transactions" asp-action="Create">
                @Html.Icon("plus", "icon-sm") New counter transaction
            </a>
        </div>
    }
</div>

<section aria-label="Branch overview" class="row g-3 mb-3">
    <div class="col-6 col-xl-3">
        <div class="card kpi-card">
            <div class="card-body">
                <span class="kpi-icon">@Html.Icon("building")</span>
                <div>
                    <p class="kpi-label">Branch status</p>
                    <p class="kpi-value">@Html.StatusBadge(Model.Branch.IsActive ? "Open" : "Closed", Model.Branch.IsActive ? "success" : "danger")</p>
                    <p class="kpi-meta">@Model.Branch.Code &middot; @Model.Branch.Region</p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card kpi-card">
            <div class="card-body">
                <span class="kpi-icon tone-accent">@Html.Icon("terminal")</span>
                <div>
                    <p class="kpi-label">Counter terminals</p>
                    <p class="kpi-value">@Model.Branch.ActiveCounterCount<span class="kpi-unit">/ @Model.Branch.CounterCount</span></p>
                    <p class="kpi-meta">@Model.Branch.ActiveCounterCount of @Model.Branch.CounterCount counter terminals active.</p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card kpi-card">
            <div class="card-body">
                <span class="kpi-icon">@Html.Icon("package")</span>
                <div>
                    <p class="kpi-label">Products</p>
                    <p class="kpi-value">@Model.ProductCount</p>
                    <p class="kpi-meta">@Model.ProductCount products in the catalogue</p>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card kpi-card">
            <div class="card-body">
                <span class="kpi-icon tone-accent">@Html.Icon("globe")</span>
                <div>
                    <p class="kpi-label">Shipping zones</p>
                    <p class="kpi-value">@Model.ShippingZoneCount</p>
                    <p class="kpi-meta">@Model.ShippingZoneCount shipping zones configured</p>
                </div>
            </div>
        </div>
    </div>
</section>

@if (Model.TodaySales is { } sales)
{
    var totals = sales.Totals;
    <section aria-label="Today's sales" class="row g-3 mb-3">
        <div class="col-6 col-xl-3">
            <div class="card kpi-card">
                <div class="card-body">
                    <span class="kpi-icon tone-success">@Html.Icon("receipt")</span>
                    <div>
                        <p class="kpi-label">Today's transactions</p>
                        <p class="kpi-value">@sales.TransactionCount</p>
                        <p class="kpi-meta">Paid, on @sales.BusinessDate.ToString("yyyy-MM-dd")</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card kpi-card">
                <div class="card-body">
                    <span class="kpi-icon tone-success">@Html.Icon("money")</span>
                    <div>
                        <p class="kpi-label">Today's sales</p>
                        @if (totals is not null)
                        {
                            <p class="kpi-value">@totals.TotalSales.ToString("N2")<span class="kpi-unit">@totals.Currency</span></p>
                            <p class="kpi-meta">Retail and services combined</p>
                        }
                        else
                        {
                            <p class="kpi-value">0</p>
                            <p class="kpi-meta">No paid transactions yet today.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card kpi-card">
                <div class="card-body">
                    <span class="kpi-icon">@Html.Icon("package")</span>
                    <div>
                        <p class="kpi-label">Retail sales</p>
                        <p class="kpi-value">@(totals?.RetailSales.ToString("N2") ?? "0")<span class="kpi-unit">@totals?.Currency</span></p>
                        <p class="kpi-meta">Goods sold at the counter</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card kpi-card">
                <div class="card-body">
                    <span class="kpi-icon tone-accent">@Html.Icon("truck")</span>
                    <div>
                        <p class="kpi-label">Service sales</p>
                        <p class="kpi-value">@(totals?.ServiceSales.ToString("N2") ?? "0")<span class="kpi-unit">@totals?.Currency</span></p>
                        <p class="kpi-meta">Shipping and money-order services</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<div class="row g-3">
    @if (Model.TodaySales is { } mix)
    {
        <div class="col-lg-6 col-xxl-4">
            <div class="card h-100">
                <div class="card-header">
                    <h2 class="card-title-sm">@Html.Icon("chart", "icon-sm") Today's sales mix</h2>
                    <a class="small" asp-controller="Reports" asp-action="DailySales">Daily sales report</a>
                </div>
                <div class="card-body">
                    @if (mix.Totals is { } totals)
                    {
                        <partial name="_DonutChart" model="@(new DonutChartViewModel(
                            [new ChartPoint("Retail", totals.RetailSales), new ChartPoint("Services", totals.ServiceSales)],
                            totals.TotalSales.ToString("N2"),
                            $"{totals.Currency} today"))" />
                    }
                    else
                    {
                        <partial name="_EmptyState" model="@(new EmptyStateViewModel("chart", "No paid transactions yet today.", "The mix appears after the first paid sale of the day."))" />
                    }
                </div>
            </div>
        </div>
    }

    <div class="col-lg-6 col-xxl-4">
        <div class="card h-100">
            <div class="card-header">
                <h2 class="card-title-sm">@Html.Icon("terminal", "icon-sm") Counter availability</h2>
            </div>
            <div class="card-body">
                @if (Model.Branch.CounterCount > 0)
                {
                    <partial name="_DonutChart" model="@(new DonutChartViewModel(
                        [new ChartPoint("Active", Model.Branch.ActiveCounterCount), new ChartPoint("Inactive", inactiveCounters)],
                        $"{Model.Branch.ActiveCounterCount}/{Model.Branch.CounterCount}",
                        "active"))" />
                }
                else
                {
                    <partial name="_EmptyState" model="@(new EmptyStateViewModel("terminal", "No counter terminals", "This branch has no counter terminals configured."))" />
                }
            </div>
        </div>
    </div>

    @if (isManager)
    {
        <div class="col-lg-12 col-xxl-4">
            <div class="card h-100">
                <div class="card-header">
                    <h2 class="card-title-sm">@Html.Icon("alert", "icon-sm") Low stock</h2>
                    @if (Model.LowStock is { Count: > 0 })
                    {
                        <a class="small" asp-controller="Reports" asp-action="LowStock">Low-stock report</a>
                    }
                </div>
                <div class="card-body">
                    @if (Model.LowStock is null)
                    {
                        <partial name="_EmptyState" model="@(new EmptyStateViewModel("info", "Not configured", "Low-stock alerts need a configured low-stock threshold."))" />
                    }
                    else if (Model.LowStock.Count == 0)
                    {
                        <partial name="_EmptyState" model="@(new EmptyStateViewModel("check", "Stock is healthy", "No products are at or below the low-stock threshold."))" />
                    }
                    else
                    {
                        <partial name="_BarChart" model="@(new BarChartViewModel(
                            Model.LowStock.Select(row => new ChartPoint(row.Sku, row.Quantity, row.Threshold)).ToArray(),
                            " units",
                            "Threshold"))" />
                    }
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card table-card">
                <div class="card-header">
                    <h2 class="card-title-sm">@Html.Icon("truck", "icon-sm") Today's shipments</h2>
                    <p class="card-note">Live courier status for up to five of today's shipments</p>
                </div>
                @if (Model.RecentShipments is null)
                {
                    <partial name="_EmptyState" model="@(new EmptyStateViewModel("info", "Courier tracking is not configured."))" />
                }
                else if (Model.RecentShipments.Count == 0)
                {
                    <partial name="_EmptyState" model="@(new EmptyStateViewModel("truck", "No shipments have been sent today."))" />
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover" aria-label="Today's shipments">
                            <thead>
                                <tr><th>Shipment</th><th>Courier status</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var shipment in Model.RecentShipments)
                                {
                                    <tr>
                                        <td><span class="code-chip">@shipment.ShipmentId</span></td>
                                        <td>
                                            @(shipment.Outcome switch
                                            {
                                                CourierLookupOutcome.Available => Html.StatusBadge(shipment.Status, "info"),
                                                CourierLookupOutcome.TimedOut => Html.StatusBadge("Courier did not respond in time", "warning"),
                                                _ => Html.StatusBadge("Courier lookup failed", "danger")
                                            })
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="col-lg-6 col-xxl-8">
            <div class="card h-100">
                <div class="card-header">
                    <h2 class="card-title-sm">@Html.Icon("dashboard", "icon-sm") Quick actions</h2>
                </div>
                <div class="card-body">
                    <div class="quick-actions">
                        @if (User.IsInRole("CounterClerk"))
                        {
                            <a class="quick-action" asp-controller="Transactions" asp-action="Create">@Html.Icon("plus") Create transaction</a>
                        }
                        <a class="quick-action" asp-controller="Catalogue" asp-action="Index">@Html.Icon("package") Product catalogue</a>
                        @if (User.IsInRole("Auditor") || User.IsInRole("Administrator"))
                        {
                            <a class="quick-action" asp-controller="Reports" asp-action="BranchAuditor">@Html.Icon("shield") Branch auditor report</a>
                            <a class="quick-action" asp-controller="Reports" asp-action="ShippingVolume">@Html.Icon("truck") Shipping volume report</a>
                        }
                        @if (User.IsInRole("Administrator"))
                        {
                            <a class="quick-action" asp-controller="Administration" asp-action="Index">@Html.Icon("settings") Administration</a>
                        }
                    </div>
                    <p class="card-note mt-3">Sales, low-stock and shipment panels are shown to branch managers.</p>
                </div>
            </div>
        </div>
    }
</div>

{
  "Storage": {
    "Directory": "data"
  },
  "DemoData": {
    "Initialize": false
  },
  "Authentication": {
    "CredentialFile": "data/staff-credentials.json",
    "SignInRateLimit": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "Maintenance": {
    "Enabled": false,
    "Message": "ApexPost is temporarily unavailable for maintenance. Please try again later."
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

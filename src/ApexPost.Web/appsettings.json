{
  "Storage": {
    "Directory": "data"
  },
  "Authentication": {
    "CredentialFile": "data/staff-credentials.json",
    "SignInRateLimit": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
